{
  "name": "overcome-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test lib/src/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions",
    "encrypt-book": "npm run build && node lib/scripts/encrypt-book.js",
    "seed": "npm run build && node lib/scripts/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "googleapis": "^188.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
