rules_version = '2';

// Encrypted book files are never readable directly: the app receives
// 10-minute signed URLs from getBookAccess (which bypass these rules) only
// when the user is entitled. Covers are public marketing images.
service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Photos a user shares with their coach: private to them, images only, ≤ 5 MB.
    match /users/{uid}/chat/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
